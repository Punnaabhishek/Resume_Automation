# --- API ---
API_BASE_URL=http://localhost:4000/api/v1

# Must match WORKER_API_TOKEN in the API's .env. This is the worker's only credential;
# it grants access to every /worker/* route, including credential decryption.
WORKER_API_TOKEN=change-me-to-match-the-api

# Identifies this process in automation_runs.worker_id and credential_access_log.
# Give every process a distinct value — that attribution is the point.
WORKER_ID=worker-1

# Portals this process will claim. Empty = any. Use to shard across processes.
WORKER_PORTALS=

# --- Browser ---
WORKER_HEADLESS=true
WORKER_NAVIGATION_TIMEOUT_MS=45000
WORKER_ACTION_TIMEOUT_MS=15000
WORKER_SCREENSHOT_DIR=./screenshots

# Where the API keeps its storage root, so persisted browser sessions can be re-read.
# Worker and API must share this volume for session reuse to work at all; without it
# every run logs in fresh and triggers a new-device check.
STORAGE_ROOT=../storage

# --- Loop ---
WORKER_IDLE_POLL_SECONDS=20
WORKER_MAX_RUN_MINUTES=90
WORKER_MAX_PAGES_PER_FILTER=3

# --- OTP handling ---
# How long to hold a run open waiting for ops to enter a code the user read back.
WORKER_OTP_WAIT_SECONDS=300
WORKER_OTP_POLL_SECONDS=5

# --- Test only ---
# Overrides the adapter chosen from the run's portal. Used by `npm run e2e` to drive the
# local mock portal. Never set this in production.
# WORKER_FORCE_ADAPTER=mock
# WORKER_MOCK_BASE_URL=http://127.0.0.1:4310
