# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jobapply
DB_PASSWORD=change-me
DB_NAME=job_apply_platform
DB_CONNECTION_LIMIT=10

# --- Auth (ops dashboard) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Worker (automation service -> API) ---
# Shared secret the Playwright worker uses on /worker/* routes.
WORKER_API_TOKEN=change-me-to-a-long-random-string

# --- Credential vault ---
# 32-byte base64 master key. Generate with: npm run keygen
# In production this should come from Azure Key Vault, not a .env file.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=1

# --- Storage ---
STORAGE_ROOT=./storage
MAX_RESUME_BYTES=10485760

# --- Automation pacing defaults (per user, per portal, per day) ---
DEFAULT_DAILY_APPLICATION_CAP=25
DEFAULT_MIN_MINUTES_BETWEEN_APPLICATIONS=4
